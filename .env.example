NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Harita zemini: OpenFreeMap vektör karolar — ücretsiz, sınırsız, anahtarsız.
NEXT_PUBLIC_HARITA_STILI=https://tiles.openfreemap.org/styles/liberty
# İsteğe bağlı ve BİLEREK BOŞ: doldurulursa zemin Google Map Tiles'a geçer.
# Map Tiles karo başına faturalanıyor ve her kaydırma onlarca karo istiyor;
# kazanç yalnızca görünüm, adres doğruluğuyla ilgisi yok. Doldurursanız
# anahtara HTTP yönlendiren (alan adı) ve Map Tiles API kısıtı koyun.
NEXT_PUBLIC_GOOGLE_HARITA_ANAHTARI=
# Google zemini açıkken 3B bina yüksekliklerini veren vektör kaynak.
NEXT_PUBLIC_BINA_KARO_KAYNAGI=https://tiles.openfreemap.org/planet

NEXT_PUBLIC_MARKET_AD=Sultan Market
NEXT_PUBLIC_MARKET_ADRES=Arabacıalanı Mah. Orhan Gazi Sk. No:19, 54050 Serdivan/Sakarya
NEXT_PUBLIC_MARKET_LAT=40.7784889
NEXT_PUBLIC_MARKET_LNG=30.3518378
# Marketin açılış saati — bu saatten önce teslimatlar "gecikti" sayılmaz.
NEXT_PUBLIC_MARKET_ACILIS=07:30
NEXT_PUBLIC_MARKET_SAAT_DILIMI=Europe/Istanbul

NEXT_PUBLIC_MERKEZ_LAT=40.7784889
NEXT_PUBLIC_MERKEZ_LNG=30.3518378
NEXT_PUBLIC_MERKEZ_ZOOM=14

# Boş = tamamen yerel. Dolu = duraklar bu OSRM sunucusuna gönderilir.
OSRM_SUNUCU=https://router.project-osrm.org

# Adres çözümleme: Google Geocoding API SUNUCU anahtarı. Tarayıcıya gitmez,
# o yüzden uygulama kısıtlaması "Yok", API kısıtlaması yalnızca Geocoding API
# olmalı. Boşsa adresler OpenStreetMap/Nominatim ile aranır; Türkiye'de kapı
# numarası verisi seyrek olduğu için pin sokak ortasına düşebilir.
GOOGLE_GEOKOD_ANAHTARI=
