# Ortak ayarlar — hem geliştirmede hem üretimde okunur.
# Buradaki değerlerin hepsi herkese açık:
# Supabase publishable key istemciye zaten gönderiliyor ve RLS ile korunuyor,
# harita/OSRM adresleri ve market konumu da gizli değil.
# Vercel'de aynı adla ortam değişkeni tanımlarsanız bunlar ezilir.
# Yerelde farklı bir değer denemek isterseniz .env.local açın (git'e girmez).

NEXT_PUBLIC_SUPABASE_URL=https://lgomzbderctwrbwlrjrw.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_Ut3ar40QqwVY2GqwgpiHLg_xpxpTcmo

# Google Map Tiles API anahtarı — harita zemini Google karolarından gelir.
# Google Cloud'da "Map Tiles API" açık olmalı; anahtara HTTP yönlendiren
# (alan adı) ve API kısıtı koyun. Boşsa harita OpenFreeMap stiline düşer.
NEXT_PUBLIC_GOOGLE_HARITA_ANAHTARI=
# Google anahtarı yokken kullanılan yedek vektör stil.
NEXT_PUBLIC_HARITA_STILI=https://tiles.openfreemap.org/styles/liberty
# 3B bina yükseklikleri için vektör karo kaynağı (Google karoları düz resim).
NEXT_PUBLIC_BINA_KARO_KAYNAGI=https://tiles.openfreemap.org/planet

NEXT_PUBLIC_MARKET_AD=Sultan Market
NEXT_PUBLIC_MARKET_ADRES=Arabacıalanı Mah. Orhan Gazi Sk. No:19, 54050 Serdivan/Sakarya
NEXT_PUBLIC_MARKET_LAT=40.7784889
NEXT_PUBLIC_MARKET_LNG=30.3518378
NEXT_PUBLIC_MARKET_ACILIS=07:30
NEXT_PUBLIC_MARKET_SAAT_DILIMI=Europe/Istanbul

NEXT_PUBLIC_MERKEZ_LAT=40.7784889
NEXT_PUBLIC_MERKEZ_LNG=30.3518378
NEXT_PUBLIC_MERKEZ_ZOOM=14

OSRM_SUNUCU=https://router.project-osrm.org

# Adres çözümleme için Google Geocoding API sunucu anahtarı (tarayıcıya
# gitmez; uygulama kısıtı olmayan, yalnızca Geocoding API'ye izinli anahtar).
# Boşsa harita anahtarı denenir; o da yoksa OpenStreetMap/Nominatim kullanılır.
GOOGLE_GEOKOD_ANAHTARI=
