NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Google Map Tiles API anahtarı — harita zemini Google karolarından gelir.
# Google Cloud'da "Map Tiles API" açık olmalı; anahtara HTTP yönlendiren
# (alan adı) ve API kısıtı koyun. Boşsa harita OpenFreeMap stiline düşer.
NEXT_PUBLIC_GOOGLE_HARITA_ANAHTARI=
# Google anahtarı yokken kullanılan yedek vektör stil.
NEXT_PUBLIC_HARITA_STILI=https://tiles.openfreemap.org/styles/liberty
# 3B bina yükseklikleri için vektör karo kaynağı (Google karoları düz resim).
NEXT_PUBLIC_BINA_KARO_KAYNAGI=https://tiles.openfreemap.org/planet

NEXT_PUBLIC_MARKET_AD=Sultan Market
NEXT_PUBLIC_MARKET_ADRES=Arabacıalanı Mah. Orhan Gazi Sk. No:19, 54050 Serdivan/Sakarya
NEXT_PUBLIC_MARKET_LAT=40.78067
NEXT_PUBLIC_MARKET_LNG=30.35218
# Marketin açılış saati — bu saatten önce teslimatlar "gecikti" sayılmaz.
NEXT_PUBLIC_MARKET_ACILIS=07:30
NEXT_PUBLIC_MARKET_SAAT_DILIMI=Europe/Istanbul

NEXT_PUBLIC_MERKEZ_LAT=40.78067
NEXT_PUBLIC_MERKEZ_LNG=30.35218
NEXT_PUBLIC_MERKEZ_ZOOM=14

# Boş = tamamen yerel. Dolu = duraklar bu OSRM sunucusuna gönderilir.
OSRM_SUNUCU=https://router.project-osrm.org
